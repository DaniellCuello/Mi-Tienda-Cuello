{
  "expo": {
    "name": "Mi Tienda",
    "slug": "mi-tienda",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mitienda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D9488"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
