# Variables de entorno públicas de Supabase para Mi Tienda
# Copia este archivo a .env y asigna las credenciales de tu proyecto de Supabase
# IMPORTANTE: .env está ignorado en .gitignore para no subir credenciales al repositorio

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

